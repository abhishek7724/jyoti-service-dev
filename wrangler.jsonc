{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "jyoti-service",
  "main": "cloudflare/worker.js",
  "compatibility_date": "2026-11-20",
  "compatibility_flags": [
    "nodejs_compat"
  ],
  "workers_dev": true,
  "preview_urls": false,
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "html_handling": "auto-trailing-slash",
    "not_found_handling": "none",
    "run_worker_first": [
      "/api",
      "/api/*"
    ]
  },
  "observability": {
    "enabled": true
  },
  "keep_vars": true,
  "routes": [
    {
      "pattern": "jyoti.krivyo.com",
      "custom_domain": true
    }
  ]
}
